+/**
+ * A large, hue-diverse "pretty color" pool (100 colors).
+ * Generated by walking the hue wheel in golden-angle steps (~137.5°) so
+ * consecutive entries land far apart on the color wheel — no clusters of
+ * similar shades — while saturation/lightness are gently varied per entry
+ * to keep every color looking intentional rather than random/muddy.
+ */
+function buildBrandPalette(count: number): string[] {
+  const GOLDEN_ANGLE = 137.508;
+  const out: string[] = [];
+  let hue = 18;
+  for (let i = 0; i < count; i++) {
+    const s = 62 + ((i * 7) % 30); // 62–92% saturation
+    const l = 48 + ((i * 11) % 24); // 48–72% lightness
+    out.push(hslToHex(hue, s, l));
+    hue = (hue + GOLDEN_ANGLE) % 360;
+  }
+  return out;
+}
+
+export const BRAND_PALETTE = buildBrandPalette(100);
 
 export type Category =
