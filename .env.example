# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values, then run `npm run dev`.
# `.env` is gitignored; this example file is committed.
#
# Every `VITE_*` var is inlined into the client bundle by
# @lovable.dev/vite-tanstack-config (see vite.config.ts) -- never put a
# secret (service-role / secret key) in a VITE_ variable.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=

# Supabase anon / publishable key (client-side safe; RLS does the real work).
# Dashboard -> Project Settings -> API Keys
VITE_SUPABASE_ANON_KEY=

# Base URL of the FastAPI palette backend (backend/palette_api.py).
# Optional -- src/lib/color-ai.ts defaults to http://localhost:8000.
VITE_PALETTE_API_URL=http://localhost:8000
